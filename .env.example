# Copy to .env and adjust as needed. start_web.sh sources this file; the
# Express server (server/config.ts) also loads it directly for `npm run dev:server`.
# Real environment variables always take precedence over values in this file.

# Port the Express backend listens on (also serves the built SPA from dist/).
PORT=8080

# Base URL of the vLLM OpenAI-compatible server, including the /v1 suffix.
# The real model id is always fetched from GET {VLLM_BASE_URL}/models — never hardcoded.
# Multiple model endpoints: comma-separated "label|baseUrl" (optionally "label|baseUrl|apiKey").
# Every model served by every listed endpoint appears in /api/models, and each
# conversation remembers which model it uses. Takes precedence over VLLM_BASE_URL.
# A gateway (LiteLLM and the like) usually REQUIRES its key — without the
# Authorization header it answers 401 — so carry the key on the entry itself
# rather than in VLLM_API_KEY, which applies to all endpoints at once.
# Example: Gateway|https://gateway.example.com/v1|sk-your-key-here
# Put real keys in the untracked .env (or in data/.model on the server);
# this file is committed, so it carries placeholders only.
VLLM_ENDPOINTS=local|http://localhost:8000/v1

# Single-endpoint fallback, used only when VLLM_ENDPOINTS is unset.
VLLM_BASE_URL=http://localhost:8000/v1

# Optional bearer token for the vLLM server. Sent as "Authorization: Bearer <key>".
# Leave empty if the server doesn't require auth.
VLLM_API_KEY=

# Where conversations/sessions are persisted as JSON files (relative to web/).
DATA_DIR=./data

# Extra serving endpoints, read from a file as well as from VLLM_ENDPOINTS, so a
# newly served model can be added without touching env or rebuilding. Lookup
# order, first existing file wins: MODEL_ENDPOINTS_FILE, then ./.model, then
# {DATA_DIR}/.model. In the container only data/ and log/ are bind-mounted, so
# {DATA_DIR}/.model is the one an operator can actually edit — a .model baked
# into the image needs a rebuild or a docker cp. One "label|baseUrl|apiKey?" per
# line, '#' comments and blank lines ignored, a bare URL accepted. Entries are
# merged with VLLM_ENDPOINTS and de-duplicated by baseUrl (the file wins on a
# label/key conflict); the file is re-read when its mtime changes, so a new line
# takes effect within the 60s model-catalog cache rather than at the next restart.
MODEL_ENDPOINTS_FILE=

# One tiny probe request per newly seen model when the model catalog is built,
# to find out what it can actually do. /v1/models lists what a gateway is
# configured for, not what works: measured 2026-09-12 on a LiteLLM gateway,
# three of its five models failed the moment anyone picked them —
#   a stale entry   400 "Invalid model name"     -> hidden
#   an embedder     400 on chat, embeddings work -> capability "embedding"
#   a reranker      400 on chat and embeddings   -> capability "rerank"
# The probe tries chat, then embeddings, then rerank, and stops at the first
# success; each verdict is cached for the life of the process, so a catalog
# refresh does not repeat it. A model that answers nothing is dropped from
# /api/models with one log line saying which model and why.
# Set to 0 to skip the probes entirely — the catalog is then whatever /v1/models
# listed, unusable models included.
MODEL_CAPABILITY_PROBE=1

# Shared secret for POST/DELETE /api/models/endpoints, sent as the
# X-Model-Admin-Token header. This is now a SECOND gate in front of those two
# routes: since accounts exist, every /api route already requires a signed-in,
# approved account. Leave it unset to let any signed-in user register a serving
# endpoint (which makes the server fetch an address they choose, and sends
# their conversations there); set it to keep that in the hands of whoever holds
# the token. Every mutation is logged with the client IP, and GET
# /api/models/endpoints reports "unprotected": true so the UI can warn.
MODEL_ADMIN_TOKEN=

# Per-model reasoning behaviour: "pattern=profile", comma separated. The pattern
# is matched as a SUBSTRING of the model id (lower-cased), so a new build of the
# same family keeps its profile.
#
#   REASONING_PROFILES=some-model=fixed,other-model=budget:256
#
#   fixed         the model gives the user nothing to choose, so no reasoning
#                 field is sent at all (some gateways 400 on them, others
#                 silently ignore them — either way sending is worse).
#   budget[:min]  levels are driven by a thinking budget, never dropping below
#                 min (default 128). Below a model's own floor a smaller budget
#                 stops buying shorter thinking and starts buying a longer
#                 answer, which is the opposite of what the user asked for.
#
# Empty (the default) puts every model on the budget profile with min 128, which
# only ever sends fields that every measured endpoint accepted. An entry that
# cannot be parsed is logged at startup rather than dropped in silence — a typo
# here changes how a model thinks and nothing else would say so.
REASONING_PROFILES=

# --- Attachments -------------------------------------------------------------
# Two independent families of limits, and they are not interchangeable:
#   bytes/pixels below are TRANSPORT limits (upload time, disk, base64 latency),
#   while the token limits are derived from the model's own context window.
#   The server rescales any image down to at most 16,386 prompt tokens however
#   large it is (measured), so a huge image is a payload problem, not a token
#   problem.

# Largest single image and text file accepted (bytes). A text file above the
# text limit is refused with 413; PDFs and Office documents are refused with 415
# and a message telling the user to screenshot the pages instead (dependency-free
# PDF text extraction was measured and yields nothing on real Korean PDFs).
ATTACHMENT_MAX_IMAGE_BYTES=10485760
ATTACHMENT_MAX_TEXT_BYTES=2097152

# Text at or below this size is inlined into the prompt verbatim; above it the
# prompt gets a short stub with a ~400-character preview and the model reads the
# rest with the read_attachment tool (offered only when such an attachment
# exists).
ATTACHMENT_INLINE_TEXT_BYTES=32768

# Per-message caps: how many attachments, and their combined bytes.
ATTACHMENT_MAX_PER_MESSAGE=6
ATTACHMENT_MAX_MESSAGE_BYTES=26214400

# Share of the CONVERSATION'S OWN model window that all attachments of one
# message may cost. 0.25 x 262144 = 65,536 tokens here; a conversation on a
# smaller model gets a proportionally smaller ceiling, because the number is
# computed from what that model reports rather than written down. One file may
# not exceed half of it on its own (refused at upload, where the user can still
# pick a smaller file). Both numbers are published per model in GET /api/models.
ATTACHMENT_MESSAGE_TOKEN_RATIO=0.25

# Used only when a model reports no context window at all; the refusal says so.
ATTACHMENT_DEFAULT_MESSAGE_TOKENS=65536

# Storage quotas per conversation and per account. (ATTACHMENT_MAX_SESSION_BYTES
# keeps its name for compatibility with deployed .env files, but attachments are
# stored per account now, so it is an account-wide quota.)
ATTACHMENT_MAX_PER_CONVERSATION=20
ATTACHMENT_MAX_CONVERSATION_BYTES=104857600
ATTACHMENT_MAX_SESSION_BYTES=524288000

# Uploads per minute per account (429 when spent), and the free space on
# DATA_DIR below which uploads are refused with 507.
ATTACHMENT_UPLOADS_PER_MINUTE=30
ATTACHMENT_MIN_FREE_DISK_BYTES=1073741824

# Comma-separated hostnames the http_fetch tool may access. Empty = allow any
# public (non-private/loopback/link-local) host.
TOOL_FETCH_ALLOWLIST=

# --- MCP (Model Context Protocol) ---------------------------------------------
# Remote MCP servers registered through /api/mcp/servers, whose tools are added
# to the model's tool list alongside the builtin ones. HTTPS ONLY, and remote
# only: a stdio/npx server would be an arbitrary command run as root, because
# this container runs as root with host networking and no resource limits.
#
# Hostnames an MCP server may live on, comma-separated. Empty = any public host,
# the same rule TOOL_FETCH_ALLOWLIST states. Note the public-host check is NOT
# the whole guard here: this deployment's model servers are themselves on public
# addresses (not loopback), so a host matching ANY configured
# vLLM endpoint is refused whatever this says — otherwise an MCP server could be
# pointed at them and use the container's network position to reach them.
MCP_ALLOWED_HOSTS=

# Hosts an MCP server may be reached on over plain http, comma separated.
# Relaxes the transport rule ONLY: the private-address refusal and the
# model-server refusal still apply to these hosts. Use it for a service you
# run yourself on the internal network with no certificate.
MCP_ALLOW_HTTP_HOSTS=

# How long a discovered tool list and health verdict stay usable before the next
# use schedules a background refresh. A TURN NEVER WAITS ON THIS: it reads the
# cache, and a stale entry only makes the NEXT turn current — the tool array
# sent to vLLM has to be byte-identical across a turn (a changed array cost 33s
# of prefill against 2.3s on a 189k-token prompt), so it can never be assembled
# from a network call mid-turn. A server that fails three times running is
# quarantined for 30 minutes and contributes no tools at all.
MCP_DISCOVERY_TTL_MS=600000

# Default per-call timeout written onto a newly registered MCP server, clamped
# to 1000..9000 there. Kept under TOOL_TIMEOUT_MS so the runner's cap stays the
# outer bound — and unlike the runner's, this timeout actually CANCELS the
# request instead of only rejecting the promise waiting on it.
MCP_TIMEOUT_MS=8000

# Log sha256(JSON.stringify(tools)) once per tool-calling round. Set to 1 when
# you need to CHECK that the tool array really is byte-identical across a turn:
# every round of one turn must print the same hash. Off by default — it is one
# line per round in an already busy log.
MCP_DEBUG_TOOLS_HASH=0

# API key for the Alpha Vantage builtin MCP server (https://www.alphavantage.co).
# Alpha Vantage takes the key as a query parameter and accepts no auth header,
# so it becomes part of that server's URL — /api/mcp/servers therefore reports
# the URL without its query, and the key never reaches a browser. Empty (the
# default) means the builtin is NOT seeded at all: an entry that answers every
# call with "invalid API key" in everyone's library is worse than no entry.
# Seeding happens once, so a key added later takes effect at the next restart.
ALPHAVANTAGE_API_KEY=

# Endpoint of the SF-1 RAG MCP server, which searches the indexed document
# corpus. Empty (the default) means that builtin is NOT seeded, for the same
# reason as the key above. Seeding happens once, but the URL is realigned with
# this value at every restart, so moving the server only needs a restart.
RAG_MCP_URL=

# The GitLab issue MCP server, and the token it works with. BOTH are required:
# either one empty means that builtin is NOT seeded, for the same reason as
# above.
#
# The token stays HERE and not on the MCP server. It is appended to the URL as
# ?token=... when the builtin is seeded, and that server forwards it to GitLab
# without keeping a copy. One secret therefore does two jobs: GitLab checks it,
# and it is what makes the MCP port useless to anyone who reaches it without
# it. /api/mcp/servers reports the URL without its query, so it never reaches a
# browser — the same handling Alpha Vantage's key gets.
#
# The token should be a project-scoped read token; the tools only read. Seeding
# happens once, but the URL is realigned at every restart, so rotating the
# token only needs a restart.
GITLAB_MCP_URL=
GITLAB_TOKEN=

# The GitLab the MCP server above covers, as a URL or a bare hostname.
#
# The app never calls GitLab itself. It needs the name for one reason: this
# container cannot complete GitLab's TLS chain (the server sends no
# intermediate certificate, and Node — unlike macOS — does not fetch one), so
# http_fetch and article_extract would spend ten seconds timing out and then
# tell the model nothing useful. Naming the host here makes those two tools
# refuse it up front and point the model at the mcp__gitlab__* tools instead,
# and adds one sentence saying so to their descriptions.
#
# Empty (the default) means no such rule. Set it only when the MCP server is
# configured; otherwise you would be refusing a host with nothing to offer in
# its place.
GITLAB_URL=

# The secret this application presents when it tells a first-party MCP server
# WHO is asking, so that server can filter documents by that person.
#
# It authenticates the APPLICATION, not a user: it is not any owner's
# credential, it is never stored in an owner's file, and it is sent only to a
# server whose record opts in (McpServerRecord.sendUserIdentity, which is set in
# code and by no route). It must match RAG_IDENTITY_TOKEN on the RAG server.
#
# Empty (the default) means no identity is sent and such a server answers every
# request as its own default account — everyone then sees the shared documents
# and no one sees anyone's private ones. That is the safe direction, and it is
# why a missing value does not fall back to trusting the header on its own.
MCP_IDENTITY_TOKEN=

# The search engine uploaded documents are indexed INTO (the 문서 page). Reading
# is the MCP server's job and needs none of this; what this turns on is the
# write half. Empty (the default) switches the page off rather than showing one
# whose every action fails.
#
# The container runs with --network host, so the engine's loopback-only bind is
# reachable here as localhost — which is also why it is not exposed to anyone
# else on the network.
RAG_ENGINE_URL=

# Collection uploaded documents go into. It must already exist with the fields
# the app writes (DOCID, PARENT_ID, TITLE, BODY, SOURCE, ORD, ACL, OWNER,
# SCOPE) — the app fails clearly rather than creating one, because a schema is
# an operational decision and a guessed one is worse than an error.
RAG_COLLECTION=rag

# Largest document accepted for indexing, in bytes. The engine embeds every
# chunk AS IT INDEXES — about 34ms each, measured — so this is really a ceiling
# on how long one upload holds the connection. 512KB is roughly 290 chunks,
# about ten seconds, and around 180,000 Korean characters. Raising it without
# adding progress reporting makes a slow upload look like a hung one.
RAG_DOC_MAX_BYTES=524288

# The model that picks chunk boundaries, and where it lives (an OpenAI-shaped
# endpoint, without the /chat/completions path — e.g. http://host:30100/v1).
#
# It is asked for LINE NUMBERS and never for text, and the reason is measured:
# asking the same model to emit the chunk bodies returned 98.4% of an
# 828-character document and silently dropped its heading, while asking for
# boundaries took 0.2s and eight output tokens with the text untouched, because
# the cutting stays ours. Long documents are split into 6,000-character windows
# and asked eight at a time — about 772ms per window, so a 160KB document costs
# a second or two on top of indexing.
#
# Empty means chunking stays purely rule-based. So does a model that is down,
# slow, or answering nonsense: each window falls back on its own, because a
# slightly worse boundary beats a failed upload.
RAG_CHUNK_MODEL_URL=
RAG_CHUNK_MODEL=
RAG_CHUNK_TOKEN=

# Largest PDF accepted, in bytes. Separate from RAG_DOC_MAX_BYTES because a PDF
# is mostly fonts and images — a 9MB manual carries a few hundred KB of text —
# so the file size says almost nothing about the indexing cost. What is capped
# by RAG_DOC_MAX_BYTES is the TEXT that comes out of it.
#
# Text is extracted in-process with no dependency beyond zlib. Measured over 27
# real PDFs (Hancom, Word, Chrome print, ezPDF, macOS): 25 extracted, the two
# that did not are scans — images of paper, which have no text to find and are
# refused with that explanation.
RAG_PDF_MAX_BYTES=20971520

# Root directory the read_text_file / list_directory tools may read from.
# Defaults to the web/ directory itself.
TOOL_FS_ROOT=.

# Hard cap on tool-calling rounds in one assistant turn. 0 = unlimited, which
# is the default: the turn ends when the model stops calling tools or when the
# prompt approaches the model's context window (see CONTEXT_TOOL_STOP_RATIO).
TOOL_MAX_ROUNDS=0

# Hard cap on ONE tool call, in milliseconds. The runner aborts a tool that is
# still working when this expires and hands the model a timeout, which it then
# answers around. The whole turn waits on this, so a generous value is paid in
# latency every time a tool hangs; raise it only for an allowlisted internal
# service that is genuinely slow to answer. Anything under 1000 is ignored.
TOOL_TIMEOUT_MS=10000

# Timeout for a single outbound HTTP request made by a tool (web_search,
# http_fetch, article_extract, currency_convert). The two-leg tools —
# weather_lookup geocodes then forecasts, wikipedia_lookup searches then reads
# the summary — give each leg 60% of it, so one slow leg cannot eat the budget
# the other one still needs. TOOL_TIMEOUT_MS stays the outer bound: raising this
# above it buys nothing, because the runner aborts the tool first.
TOOL_HTTP_TIMEOUT_MS=10000

# How much of one tool result reaches the model; the rest is cut with a
# "...[truncated]" marker. This is the number the context settings below are
# written against — one 100KB http_fetch result is roughly 25k tokens — so
# raising it makes every research round cost proportionally more of the window
# and makes compaction fire sooner.
TOOL_MAX_RESULT_BYTES=102400

# Once the prompt fills this fraction of the model's context window, the server
# stops offering tools and lets the model answer with what it already has.
# Another tool result on top of a nearly-full window is what the server rejects
# with "maximum context length is 262144 tokens", losing the whole turn.
CONTEXT_TOOL_STOP_RATIO=0.8

# Once the prompt fills this fraction of the context window while tools are
# still being offered, the server summarises the research the turn has gathered
# into one interim research report and rebuilds the turn's context around it,
# instead of shrinking tool results to 600-char excerpts and losing the
# research. 0 disables compaction. Must be BELOW CONTEXT_TOOL_STOP_RATIO —
# above it, tools are switched off before compaction ever fires, so a value
# that is not below is clamped (with a warning at startup). 0.7 also keeps the
# summarisation call itself inside the window: 0.7 x 262144 ~= 183.5k input
# plus an 8192-token report.
CONTEXT_COMPACT_RATIO=0.7

# How much of the window compaction leaves un-summarised. The most recent tool
# exchanges (one assistant tool-call message with its results) are kept word for
# word while their combined token count stays under this fraction; only older
# ones are replaced by the report. Those newest results are what the model is
# still reasoning about, and a summary loses the detail exactly there.
# 0.15 x 262144 ~= 39k tokens, room for the last one or two 100KB fetch results.
# Keep it well below CONTEXT_COMPACT_RATIO: at or above it nothing is ever old
# enough to summarise, so compaction frees nothing and the turn falls back to
# truncating tool results.
CONTEXT_KEEP_RECENT_RATIO=0.15

# How many times a single assistant turn may compact. Each compaction costs one
# extra model call, and this cap is what keeps the tool loop terminating: once
# it is spent the prompt grows monotonically again and CONTEXT_TOOL_STOP_RATIO
# ends the loop.
CONTEXT_MAX_COMPACTIONS=2

# Ceiling on how long the model may think in "normal" reasoning mode, in
# milliseconds. When it passes, the turn is stopped and the model is asked, in a
# second call with no tools and no thinking, to write its answer from the
# reasoning it already produced — so the user gets an answer built from real
# work instead of an empty turn. "External" reasoning mode ignores this and
# waits for the model however long it takes.
# Three minutes by default: measured here, one and the same question finished in
# 35s on one run and was still thinking after twenty minutes on another. The
# ceiling is also announced to the user when it fires, in minutes or seconds.
# Anything unparseable or under 1000 falls back to the default.
NORMAL_MODE_DEADLINE_MS=180000

# Name of the httpOnly session cookie. The cookie identifies the BROWSER; after
# a successful login the session record also carries the account id, and that is
# what makes the session authenticated.
SESSION_COOKIE_NAME=sid

# --- Accounts and the first admin --------------------------------------------
# Every /api route except /api/auth/{signup,login,logout,me} now requires a
# signed-in account whose status is "active". A signup is created "pending" and
# an admin has to approve it, so a deployment with no admin cannot approve
# anyone: create the first one here.
#
# There is deliberately NO default password. A missing or shorter-than-8
# ADMIN_PASSWORD is refused at startup with an explicit log line, and the
# account is only created when ADMIN_ID does not already exist — changing
# ADMIN_PASSWORD later does NOT reset an existing admin's password.
#
# Stored passwords are scrypt hashes (N=32768, r=8, p=1, 32-byte salt per
# account, compared with timingSafeEqual); this file is the one place a
# password exists in the clear. Once the admin account has been created, the
# value here is read and ignored on every later start, so DELETE THE LINE —
# the admin changes their own password in the app from then on.
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=

# Login attempts per minute, refilled continuously (429 when spent). Two
# buckets, because they stop two different attacks: per id, a password list run
# against one account; per address, one host working through many accounts. The
# per-IP number is the looser of the two on purpose — a whole office can share
# one address.
LOGIN_ATTEMPTS_PER_MINUTE=10
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=30

# Used only by vite.config.ts in dev — where the Vite dev server proxies /api to.
BACKEND_URL=http://localhost:8080

# API key for the web_search tool (https://tavily.com). Without it, web_search
# fails with a clear "not configured" error; the other tools are unaffected.
# This is the one key an operator has to obtain from a third party, and the
# failure is invisible until someone asks a question that needs the web — check
# it first when web search "does nothing".
TAVILY_API_KEY=

# Where web_search sends its query. Worth changing only for a Tavily-compatible
# proxy, or a mirror inside a network that cannot reach api.tavily.com: the
# request body and the "Authorization: Bearer <TAVILY_API_KEY>" header are
# Tavily's own shape, so whatever answers here has to speak it.
TAVILY_API_URL=https://api.tavily.com/search

# Set to 1 only when serving over HTTPS. On plain HTTP a Secure cookie is
# dropped by the browser, which would break session continuity.
COOKIE_SECURE=

# 날짜별 로그 파일이 놓이는 곳. 앱이 직접 열고, 날짜가 바뀌면 파일도 바뀐다 —
# 예전에는 기동 스크립트의 리다이렉션이 파일명을 한 번만 정해서, 자정을 넘긴
# 기록이 전날 파일에 쌓였다. 비우면 stdout 만 쓴다.
LOG_DIR=log

# ─────────────────────────────────────────────── 프로세스 수명과 로그

# 잡히지 않은 예외를 만났을 때. exit (기본) | keep
#
# exit 이 옳은 값이다 — Node 의 기본 동작이고, 무엇이 망가졌는지 모르는 채로
# 요청을 계속 받느니 죽고 다시 뜨는 편이 낫다. **다만 다시 띄워 줄 것이 있을
# 때 얘기다.** 감시자(systemd 유닛, docker restart 정책)가 없는 배포에서 이
# 값을 쓰면 예외 한 번이 곧 서비스 중단이 된다. 그런 곳에서는 keep 으로 두되,
# 그건 "깨진 상태로 계속 돈다" 는 뜻임을 알고 쓰는 것이다.
CRASH_POLICY=exit

# SIGTERM 을 받은 뒤 진행 중인 요청에 주는 시간(ms). 기본 15000.
# 이 시간이 지나면 남은 연결을 끊고 나간다. 답변 생성이 이보다 길 수 있으므로
# 너무 짧게 두면 사용자의 답변이 중간에 끊긴다.
SHUTDOWN_GRACE_MS=15000

# 남길 로그의 최소 등급. debug | info (기본) | warn | error | silent
# 요청 한 건마다 [http] 한 줄이 info 로 남는다. 조용히 하려면 warn.
LOG_LEVEL=info
